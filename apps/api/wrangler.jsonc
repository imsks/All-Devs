{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alldevs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alldevs-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOMS", "class_name": "CircleRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CircleRoom"] }]
}